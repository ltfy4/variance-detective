# Copy to .env and fill in what you use. Nothing here is required for the offline demo.

# ---- LLM provider (pick one) -----------------------------------------------
VD_LLM_PROVIDER=offline                 # offline | anthropic | bedrock | azure_openai | openai
VD_LLM_MODEL=claude-sonnet-4-5

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Amazon Bedrock (standard AWS credential chain; prefer an IAM role in production)
# AWS_REGION=eu-west-2
# AWS_PROFILE=finance-ai
# VD_LLM_MODEL=anthropic.claude-sonnet-4-5-20250929-v1:0    # or an inference profile ARN

# Azure OpenAI
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_KEY=...

# OpenAI-compatible (OpenAI, Ollama, vLLM, Groq)
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=http://localhost:11434/v1

# ---- Sources ----------------------------------------------------------------
# SAC-MCP
# SAC_TENANT_URL=https://<tenant>.eu10.hcs.cloud.sap
# SAC_CLIENT_ID=...
# SAC_CLIENT_SECRET=...
# SAC_TOKEN_URL=https://<tenant>.authentication.eu10.hana.ondemand.com/oauth/token
# SAC_MODEL_ID=t.1:C3abc...

# Generic planning MCP over HTTP
# PLANNING_MCP_URL=https://planning-mcp.internal/mcp
# PLANNING_MCP_TOKEN=...
